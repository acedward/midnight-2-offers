# Local, per-machine configuration (never committed — .env.example is the template)
.env
.env.*
!.env.example

# Local test artifacts — the workspace rule is "do not commit docker artifacts for testing"
.test/
*.log
logs/

# The midnight-node-toolkit fetch/ledger cache, one directory per compose project.
# Wiped by ./down.sh -v.
.cache/

# Generated wallet material (dev-only, but regenerate rather than commit)
wallets/generated/

# Build output / deps of the vendored app images
node_modules/
dist/
build/

# Python bytecode from the helper scripts under scripts/lib/
__pycache__/
*.py[cod]

.DS_Store
