# midnight-2-offers — copy to .env and edit.
#
#   cp .env.example .env
#
# DEFAULTS ARE THE MIDNIGHT-STANDARD PORTS. Lace's `undeployed` preset hardcodes
# 9944 / 8088 / 6300, and the offer-files kernel and frontend default to them too, so a
# laptop demo that wants Lace must keep these. On a shared machine, override every
# HOST_PORT below with a free block above 10000 (scripts/pick-ports.sh generates one)
# and give COMPOSE_PROJECT_NAME a unique value — nothing in this stack hardcodes a
# cross-service port, so stacks can run side by side.

# ─── Compose project ─────────────────────────────────────────────────────────
# One name per stack instance. Two stacks with the same name share volumes.
COMPOSE_PROJECT_NAME=demo-infra

# ─── Image tags (the pinned-compatible 2.x triple) ───────────────────────────
NODE_TAG=2.0.0-rc.4
INDEXER_TAG=4.4.0-rc.1
PROOF_TAG=9.0.0-rc.5
# The toolkit used by scripts/fund-wallet.sh — must match NODE_TAG.
TOOLKIT_TAG=2.0.0-rc.4

# The indexer is published for linux/amd64 only at 4.4.0-rc.1; on Apple Silicon it
# runs emulated. Change only if an image for your native arch appears.
INDEXER_PLATFORM=linux/amd64

# ─── Host ports (core profile) ───────────────────────────────────────────────
NODE_HOST_PORT=9944
INDEXER_HOST_PORT=8088
PROOF_HOST_PORT=6300

# Interface the host ports bind to. 127.0.0.1 keeps the stack off the network of a
# shared machine; set to 0.0.0.0 only if a remote browser must reach it.
BIND_ADDR=127.0.0.1

# ─── Host ports (later profiles — reserved, see README) ──────────────────────
# evm profile (Phase 3)
EVM_RPC_HOST_PORT=8545
EVM_WS_HOST_PORT=10021
# offerfiles profile (Phase 4)
KERNEL_HOST_PORT=9999
BATCHER_HOST_PORT=3334
CELESTIA_HOST_PORT=26658
# frontend profile (Phase 5)
FRONTEND_HOST_PORT=10600

# ─── Indexer ─────────────────────────────────────────────────────────────────
# Hex secret the indexer uses to derive its storage keys. Required — the image's config.yaml
# has no default for it. Dev value; any 32-byte hex works.
#
# NOTE: indexer 4.4.0-rc.1 no longer has the storage/pubsub/ledger-state PASSWORD settings
# that 4.3.x compose files set. Its storage is plain sqlite under /data, so there is nothing
# to configure here beyond the secret.
INDEXER_SECRET=303132333435363738393031323334353637383930313233343536373839303132

# ─── Health-wait timeouts (seconds) ──────────────────────────────────────────
NODE_WAIT_TIMEOUT=180
INDEXER_WAIT_TIMEOUT=420
PROOF_WAIT_TIMEOUT=120
