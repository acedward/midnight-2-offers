  "sources": [
    {
      "id": "minocrab-release",
      "decision": "published-release-asset",
      "inArtifactNormalizationScope": false,
      "reason": "The AA Manager's `execute` circuit is deployed from the MinoCrab port's PUBLISHED RELEASE, not recompiled: an exact published binary is taken by SHA-256, never rebuilt, and there is no way to rebuild these at all without the pinned compactc archive, the Midnight SRS for each k, and a keygen run. This is the same rule the warehouse-binary components follow, applied to a release that is not in the warehouse. It is OUT of artifact-normalization scope because it is contract key material for one image, not an external runtime this stack schedules.",
      "repository": "acedward/AA-midnight-evm-experiment-minocrab",
      "releaseTag": "v0.2.0",
      "commit": "7cdfa5b0c994a70502ab2b564b509c8abe2f7efb",
      "contractCommit": "41de69ded41ff933fe0db8697b264dc46fc6e0cb",
      "minocrabRev": "1522f9dd024d2d9941a6fdcda1ad8f88ab7533b9",
      "downloadUrlTemplate": "https://github.com/acedward/AA-midnight-evm-experiment-minocrab/releases/download/{tag}/{name}",
      "identityNote": "THE IDENTITY IS `checksums.assetSha256`, NOT `releaseTag`. A tag is a movable label; SHA256SUMS is 3,263 bytes that name the SHA-256 of every other file in the release, `manifest.json` included, and manifest.json in turn carries the tag, the port commit, the MinoCrab rev, the contract pin, the compactc/zkir-v3 hashes and the SRS per k. Pinning that one hash pins all 38 files. The AA image asserts it before it uses a single byte.",
      "checksums": {
        "assetName": "SHA256SUMS",
        "assetSize": 3263,
        "assetSha256": "4a8c0183cd887e3ca2d3446f196fab1102540e09d6e0e8ae9c1859532d8dd7ac"
      },
      "manifest": {
        "assetName": "manifest.json",
        "assetSize": 10395,
        "assetSha256": "7d208f0d6f2cdebb0ea431508e46cce7ddb1f5aac5944bcd729db9dd6e2a7895"
      },
      "assetCount": 38,
      "assetBytes": 695875589,
      "consumedBy": "images/aa-contracts/Dockerfile stage `minocrab-release`",
      "consumption": {
        "AA_ZKIR_SOURCE=minocrab": "execute.{zkir,bzkir,verifier} always; execute.prover only when AA_PRUNE_MANAGER_PROVERS=0",
        "AA_ZKIR_SOURCE=minocrab-all": "the same four kinds for all nine circuits",
        "AA_ZKIR_SOURCE=compactc": "nothing — the release is not consulted",
        "always": "SHA256SUMS and manifest.json"
      },
