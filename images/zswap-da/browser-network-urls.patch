+    // "where is the chain", so the fallback is completed here from the same
+    // map. If a later kernel does report nodeUri, the loop above has already
+    // rewritten it and this is skipped.
+    if (typeof (data as Record<string, unknown>).nodeUri !== 'string' && hostPorts['node']) {
+      (data as Record<string, unknown>).nodeUri = `http://${pageHost}:${hostPorts['node']}`;
+    }
     return data;
   },
 
