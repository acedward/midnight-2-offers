   (import.meta.env.VITE_BATCHER_TARGET as string | undefined) ?? 'midnight-balancer';
 
+// The network the stack actually runs. Upstream resolves this at BUILD time and
+// falls back to preprod; one image has to serve any chain, and this demo's chain
+// is always `undeployed`, so a `window` value written by the entrypoint wins —
+// same shape as API_BASE/BATCHER_URL above. It reaches the faucet link as
+// `?network=<id>` (App.tsx -> buildFaucetUrl) and the wallet as its network id.
+const windowNetworkId = (window as unknown as { MIDNIGHT_NETWORK_ID?: string })
+  .MIDNIGHT_NETWORK_ID;
+
 export const MIDNIGHT_NETWORK_ID =
+  windowNetworkId?.trim() ||
   (import.meta.env.VITE_MIDNIGHT_NETWORK_ID as string | undefined)?.trim() ||
   DEFAULT_MIDNIGHT_NETWORK_ID;
 
+// The faucet base cannot be baked either, and for a sharper reason than the
+// others: the stack publishes the mint-test-tokens site on a host port only
+// Docker knows, while the host itself is only known IN THE PAGE. So the
+// entrypoint writes window.FAUCET_HOST_PORT (the PUBLISHED port) and the origin
+// is composed here from the page's own hostname — the same split
+// MIDNIGHT_HOST_PORTS uses for the wallet endpoints in services/api.ts.
+//
+// window.FAUCET_URL is the escape hatch for a faucet that is NOT on the page's
+// host (a shared or public one): a complete URL, used verbatim.
+const windowFaucetUrl = (window as unknown as { FAUCET_URL?: string }).FAUCET_URL;
+const windowFaucetPort = (window as unknown as { FAUCET_HOST_PORT?: string | number })
+  .FAUCET_HOST_PORT;
+const faucetFromPort =
+  windowFaucetPort === undefined || windowFaucetPort === null || `${windowFaucetPort}` === ''
+    ? undefined
+    : `http://${location.hostname}:${windowFaucetPort}/`;
+
 export const FAUCET_BASE_URL =
+  windowFaucetUrl?.trim() ||
+  faucetFromPort ||
   (import.meta.env.VITE_FAUCET_URL as string | undefined)?.trim() ||
   DEFAULT_FAUCET_URL;
+
+// The in-page JS wallet's seed. `connectLocal()` GENERATES a random 32-byte seed
+// when it is not given one, which makes the demo wallet a brand-new empty wallet
+// on every page load — and since upstream #922 removed the template's faucet
+// contract, an empty wallet is a wallet that can never acquire anything: it has
+// no mint of its own, and the external faucet site needs an injected extension
+// wallet it does not have either. A fixed seed makes the wallet the STACK's
+// demo wallet, which the faucet-mint one-shot can prefund and which survives a
+// reload. Absent (the upstream default) it stays random, which is the right
+// behaviour for anyone serving this bundle outside the demo.
+export const DEMO_WALLET_SEED =
+  (window as unknown as { DEMO_WALLET_SEED?: string }).DEMO_WALLET_SEED?.trim() || undefined;
