+      const m = value.match(/^(\w+:\/\/)([^/:]+)(?::(\d+))?(.*)$/);
+      if (!m || m[2].includes('.') || m[2] === 'localhost') continue;
+      const mapped = hostPorts[m[2]];
+      const port = mapped === undefined || mapped === null || `${mapped}` === '' ? m[3] : `${mapped}`;
