# TEST-ONLY compactc toolchain for the ZKIR fixture stage of the proof-data cache gate.
#
# It ships the pinned compiler and NOTHING generated by it. Compilation happens in a
# `docker run` that writes into a test-scoped volume, never in a build step, because the
# generated contract proving keys must never land in an OCI layer (plan 00003 T3.7 /
# spec FR-013). `tests/run-gate.sh` asserts that boundary directly: the built image must
# contain no `*.prover` file.
#
# The pin is the SAME compactc release asset the demo already uses for the kernel and AA
# contracts (`compactc-v0.33.0-rc.2`, which reports itself as 0.33.0). Adopting it here
# changes no demo toolchain pin — see spec FR-014 — and it is v3-capable out of the box:
# the archive ships both backends, `zkir` (2.2.0) and `zkir-v3` (3.0.0-rc.2), and
# `compactc --feature-zkir-v3` selects the latter. No newer compiler is required.
#
# Release assets (SHA-256 of the downloaded ZIP, verified below):
#   x86_64-unknown-linux-musl   3055ab92bbc8d5bb0d6282b661b83761d2a0de2ee37e21cf7107e25aaf2a9aad
#   aarch64-unknown-linux-musl  3aa23812b0b086dbce07da3931a40dcb01bec9676b1ceed7f2d0be370ab2dc46
# from https://github.com/LFDT-Minokawa/compact/releases/download/compactc-v0.33.0-rc.2/

FROM debian:stable-slim

ARG COMPACT_VERSION=0.33.0-rc.2
ARG COMPACTC_SHA256_AMD64=3055ab92bbc8d5bb0d6282b661b83761d2a0de2ee37e21cf7107e25aaf2a9aad
ARG COMPACTC_SHA256_ARM64=3aa23812b0b086dbce07da3931a40dcb01bec9676b1ceed7f2d0be370ab2dc46
ARG TARGETARCH

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates unzip bash \
 && rm -rf /var/lib/apt/lists/*

# Musl-static release asset, one per platform triple. No symlinking into /usr/local/bin:
# the bundled `compactc` wrapper resolves its siblings (`compactc.bin`, `zkir`, `zkir-v3`)
# from `dirname $0`.
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      arm64) triple="aarch64-unknown-linux-musl"; want="${COMPACTC_SHA256_ARM64}" ;; \
      amd64) triple="x86_64-unknown-linux-musl";  want="${COMPACTC_SHA256_AMD64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/LFDT-Minokawa/compact/releases/download/compactc-v${COMPACT_VERSION}/compactc_v${COMPACT_VERSION}_${triple}.zip"; \
    curl --proto '=https' --tlsv1.2 -fLsS -o /tmp/compactc.zip "$url"; \
    echo "${want}  /tmp/compactc.zip" | sha256sum -c -; \
    mkdir -p /opt/compactc; \
    unzip -q /tmp/compactc.zip -d /opt/compactc; \
    rm /tmp/compactc.zip; \
    chmod +x /opt/compactc/*; \
    test -x /opt/compactc/zkir    || { echo "asset lacks the default zkir backend" >&2; exit 1; }; \
    test -x /opt/compactc/zkir-v3 || { echo "asset lacks the zkir-v3 backend" >&2; exit 1; }; \
    test "$(/opt/compactc/compactc --version)"         = "0.33.0"      || exit 1; \
    test "$(/opt/compactc/compactc --runtime-version)" = "0.18.0-rc.1" || exit 1

COPY zkir-fixture.compact /fixture/zkir-fixture.compact
COPY compile.sh /usr/local/bin/compile-zkir-fixture
RUN set -eu; \
    chmod +x /usr/local/bin/compile-zkir-fixture; \
    if find / -xdev -name '*.prover' -print -quit | grep -q .; then \
      echo "toolchain image must contain no proving key" >&2; exit 1; \
    fi

ENTRYPOINT ["/usr/local/bin/compile-zkir-fixture"]
